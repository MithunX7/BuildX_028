# Nagpur Civic Infrastructure Coordination Platform Environment Variables

# MongoDB Connection String
MONGODB_URI="mongodb://localhost:27017/nagpur_civic"
DATABASE_URL="mongodb://localhost:27017/nagpur_civic"

# Session / JWT Secret (min 32 chars)
AUTH_SECRET="nagpur-civic-dev-super-secret-key-change-in-production-2026"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (local or s3)
STORAGE_PROVIDER="local"
STORAGE_PATH="./public/uploads"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Optional Custom Map Tiles
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
